# Mira Cognitive OS production configuration
MIRA_ENV=production
MIRA_MODEL_PROVIDER=openai
MIRA_MODEL=
OPENAI_API_KEY=
MIRA_PERSISTENCE=postgres
DATABASE_URL=
MIRA_POSTGRES_SCHEMA=mira_core

# Runtime limits
MIRA_WORKER_CONCURRENCY=4
MIRA_MAX_QUEUE=100
MIRA_LEASE_TTL_MS=30000
MIRA_MODEL_TIMEOUT_MS=60000
MIRA_HEALTH_WINDOW=100
MIRA_MAX_ERROR_RATE=0.2
MIRA_MAX_P95_LATENCY_MS=30000

# Database pool
# Vercel/serverless: use Supabase Transaction pooler (port 6543) and keep pool size at 1.
MIRA_DB_POOL_MAX=1
MIRA_DB_IDLE_TIMEOUT_MS=30000
MIRA_DB_CONNECT_TIMEOUT_MS=10000
MIRA_DB_SSL=true
MIRA_DB_SSL_REJECT_UNAUTHORIZED=true

PORT=8080
HOST=0.0.0.0
